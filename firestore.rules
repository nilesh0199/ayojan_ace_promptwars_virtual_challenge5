rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all access to arbitrary top-level collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for strict authentication & authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validates that an event plan document strictly matches the required schema
    function isValidPlanData(data, planId) {
      return data.keys().hasOnly([
        'id', 'title', 'eventType', 'city', 'date', 
        'guestCount', 'totalBudget', 'currency', 'styleCulture', 
        'nonNegotiables', 'budget', 'timeline', 'vendors', 
        'ideas', 'createdAt', 'updatedAt', 'version', 'isSavedExample',
        'eventName', 'muhuratTime', 'muhuratLabel', 'generationSource', 'providerNotice'
      ])
      && data.keys().hasAll([
        'id', 'title', 'eventType', 'city', 'date', 
        'guestCount', 'totalBudget', 'currency', 'styleCulture', 
        'nonNegotiables', 'budget', 'timeline', 'vendors', 
        'ideas', 'createdAt', 'updatedAt', 'version', 'isSavedExample'
      ])
      && data.id == planId
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
      && data.eventType in ['Wedding', 'Birthday', 'Community Event']
      && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
      && data.date is string && data.date.size() >= 8 && data.date.size() <= 30
      && data.guestCount is int && data.guestCount >= 2 && data.guestCount <= 50000
      && data.totalBudget is number && data.totalBudget > 0 && data.totalBudget <= 1000000000
      && data.currency in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'CAD', 'AUD']
      && data.styleCulture is string && data.styleCulture.size() <= 300
      && data.nonNegotiables is string && data.nonNegotiables.size() <= 500
      && data.budget is map
      && data.budget.categories is list && data.budget.categories.size() >= 1 && data.budget.categories.size() <= 30
      && data.budget.contingencyPercent is number && data.budget.contingencyPercent >= 0 && data.budget.contingencyPercent <= 50
      && data.budget.taxServiceChargePercent is number && data.budget.taxServiceChargePercent >= 0 && data.budget.taxServiceChargePercent <= 50
      && data.budget.statedAssumptions is list && data.budget.statedAssumptions.size() <= 20
      && data.timeline is list && data.timeline.size() >= 1 && data.timeline.size() <= 100
      && data.vendors is list && data.vendors.size() >= 1 && data.vendors.size() <= 50
      && data.ideas is map
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 40
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40
      && data.version is int && data.version >= 1 && data.version <= 10000
      && data.isSavedExample is bool
      && (!('eventName' in data) || (data.eventName is string && data.eventName.size() <= 120))
      && (!('muhuratTime' in data) || (data.muhuratTime is string && data.muhuratTime.size() <= 10))
      && (!('muhuratLabel' in data) || (data.muhuratLabel is string && data.muhuratLabel.size() <= 40))
      && (!('generationSource' in data) || (data.generationSource in ['primary', 'backup', 'template']))
      && (!('providerNotice' in data) || (data.providerNotice is string && data.providerNotice.size() <= 500));
    }

    // Validates snapshot version record in the versions subcollection
    function isValidVersionData(data, planId) {
      return data.keys().hasOnly(['versionNumber', 'savedAt', 'planData'])
      && data.keys().hasAll(['versionNumber', 'savedAt', 'planData'])
      && data.versionNumber is int && data.versionNumber >= 1 && data.versionNumber <= 10000
      && data.savedAt is string && data.savedAt.size() >= 10 && data.savedAt.size() <= 40
      && data.planData is map
      && isValidPlanData(data.planData, planId);
    }

    // Isolated user-scoped collection for celebration plans
    match /users/{userId}/plans/{planId} {
      // Users can only view or delete documents strictly under their own UID
      allow read, delete: if isOwner(userId);

      // Create and update enforced with strict schema, matching ID, and bounded sizes
      allow create, update: if isOwner(userId)
        && isValidPlanData(request.resource.data, planId);

      // Plan versions history subcollection (capped at latest 20 versions)
      match /versions/{versionId} {
        // Read and delete allowed only for the document owner
        allow read, delete: if isOwner(userId);

        // Version creation requires ownership and strict version record validation
        allow create: if isOwner(userId)
          && isValidVersionData(request.resource.data, planId);

        // Updates to existing version snapshots are explicitly disallowed (immutable history)
        allow update: if false;
      }
    }
  }
}
