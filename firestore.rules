rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all access to arbitrary top-level collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for strict validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidPlanData(data) {
      return data.keys().hasAll([
        'id', 'title', 'eventType', 'city', 'date', 
        'guestCount', 'totalBudget', 'currency', 'budget', 
        'timeline', 'vendors', 'ideas', 'updatedAt', 'version'
      ])
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
      && data.eventType in ['Wedding', 'Birthday', 'Community Event']
      && data.city is string && data.city.size() <= 80
      && data.guestCount is int && data.guestCount >= 2 && data.guestCount <= 50000
      && data.totalBudget is number && data.totalBudget > 0 && data.totalBudget <= 1000000000
      && data.currency in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'CAD', 'AUD']
      && data.budget is map
      && data.timeline is list
      && data.vendors is list
      && data.ideas is map
      && data.version is int;
    }

    // Isolated user-scoped subcollection for celebration plans
    match /users/{userId}/plans/{planId} {
      // Users can only view or delete documents stored strictly under their own UID
      allow read, delete: if isOwner(userId);

      // Enforce payload size < 400KB and strict schema on create/update
      allow create, update: if isOwner(userId)
        && request.resource.data.size() < 400000
        && isValidPlanData(request.resource.data);

      // Plan versions history subcollection (capped at latest 20 versions)
      match /versions/{versionId} {
        allow read, write, delete: if isOwner(userId);
      }
    }
  }
}
