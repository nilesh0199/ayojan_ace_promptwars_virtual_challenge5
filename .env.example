# ==============================================================================
# Aayojan Ace Environment Configuration Template (.env.example)
# Copy this file to .env.local and configure your credentials.
# NEVER commit your production secrets or .env.local to source control.
# ==============================================================================

# Server-only: Google Gemini AI Secret Key
# Required. Generated in Google AI Studio (https://aistudio.google.com/).
# Never exposed in client code or browser network requests.
GEMINI_API_KEY=your_gemini_api_key_here

# Server-only: Google Gemini Primary Model
# Optional. Default: gemini-3.8-flash. Recommended for high-speed structured planning.
GEMINI_MODEL=gemini-3.8-flash

# Server-only: Google Gemini Fallback Model
# Optional. Default: gemini-3.5-flash. Automatically invoked if the primary model is busy or throttled.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Client-safe: Firebase Authentication & Web SDK API Key
# Public identifier from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey

# Client-safe: Firebase Authentication Domain
# Domain used for Google OAuth popup sign-in redirects.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aayojan-ace-app.firebaseapp.com

# Client-safe: Firebase Project Identifier
# Cloud Firestore project ID scoping all document read/write paths.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aayojan-ace-app

# Client-safe: Firebase Cloud Storage Bucket
# Storage bucket reference for Firebase project assets.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aayojan-ace-app.appspot.com

# Client-safe: Firebase Cloud Messaging Sender ID
# Numeric identifier for project messaging services.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Client-safe: Firebase Web App ID
# Unique client web application registration ID.
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
