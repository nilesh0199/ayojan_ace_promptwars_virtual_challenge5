# ==============================================================================
# Aayojan Ace Environment Configuration Template (.env.example)
# Copy this file to .env.local and configure your credentials.
# NEVER commit your production secrets or .env.local to source control.
#
# IMPORTANT BUILD-TIME NOTICE FOR NEXT_PUBLIC_* VARIABLES:
# In Next.js, all NEXT_PUBLIC_* variables are statically inlined into client
# JavaScript at BUILD TIME via literal property accesses (process.env.NEXT_PUBLIC_*).
# Dynamic lookups (e.g. process.env[name]) return undefined in browser runtime.
#
# • Production / Vercel Deployments:
#   Any changes made to NEXT_PUBLIC_* variables in Vercel Project Settings require
#   triggering a REDEPLOY for the new values to take effect in client bundles.
#
# • Local Development:
#   Configure your variables in .env.local and RESTART the dev server (npm run dev)
#   whenever modifying any environment variable.
# ==============================================================================

# Server-only: Google Gemini AI Secret Key (Primary)
# Required. Generated in Google AI Studio (https://aistudio.google.com/).
# Never exposed in client code or browser network requests.
GEMINI_API_KEY=your_gemini_api_key_here

# Server-only: Google Gemini AI Fallback Key (Backup Project)
# Optional. Generated in a DIFFERENT Google Cloud / AI Studio project.
# Since Gemini API quota and rate limits (429 / RESOURCE_EXHAUSTED) are enforced per project,
# providing a backup key from a secondary GCP project allows automated failover during quota exhaustion.
GEMINI_API_KEY_FALLBACK=your_secondary_project_gemini_api_key_here

# Server-only: Google Gemini Primary Model
# Optional. Default: gemini-flash-lite-latest. Recommended for high-speed structured planning.
GEMINI_MODEL=gemini-flash-lite-latest

# Server-only: Google Gemini Fallback Model
# Optional. Default: gemini-3.5-flash-lite. Automatically invoked if the primary model is busy or throttled.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Server-only: Optional Secondary AI Provider (Groq Cloud)
# Optional. Generated in Groq Console (https://console.groq.com/).
# When set, Aayojan Ace automatically routes requests to Groq if Google Gemini encounters
# rate limits (429), server overload (503), or network timeouts before falling back to the template planner.
# The Groq provider is enabled strictly when GROQ_API_KEY is non-empty. Never exposed to browser.
GROQ_API_KEY=your_groq_api_key_here

# Server-only: Groq Cloud Model Selection
# Optional. Set to a supported chat completion model in your Groq account (e.g. openai/gpt-oss-120b or qwen/qwen3.8-27b).
# If Groq returns 404 (model not found), it disables Groq for the session and falls back to template plans.
GROQ_MODEL=openai/gpt-oss-120b

# Server-only: Groq Backup Key Expiration Window
# Optional. ISO date (e.g. 2026-12-22) marking the end of the backup demo key's validity window.
# If configured and the date has passed in UTC, Aayojan Ace skips the Groq provider entirely,
# treats the backup key as expired without making network calls, and continues the fallback cascade.
GROQ_KEY_EXPIRES_ON=2026-12-22

# Client-safe: Firebase Authentication & Web SDK API Key
# Public identifier from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey

# Client-safe: Firebase Authentication Domain
# Domain used for Google OAuth popup sign-in redirects.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aayojan-ace-app.firebaseapp.com

# Client-safe: Firebase Project Identifier
# Cloud Firestore project ID scoping all document read/write paths.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aayojan-ace-app

# Client-safe: Firebase Cloud Storage Bucket
# Storage bucket reference for Firebase project assets.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aayojan-ace-app.appspot.com

# Client-safe: Firebase Cloud Messaging Sender ID
# Numeric identifier for project messaging services.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Client-safe: Firebase Web App ID
# Unique client web application registration ID.
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
